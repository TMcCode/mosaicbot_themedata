{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "census_construction.v0.schema.json",
  "title": "Census C-30 construction spending (via FRED)",
  "type": "object",
  "required": ["schema_version", "source", "fetched_at", "as_of", "series"],
  "properties": {
    "schema_version": { "const": 0 },
    "source": { "type": "string" },
    "fetched_at": { "type": "string" },
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "series": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["fred_id", "label", "unit", "points", "latest"],
        "properties": {
          "fred_id": { "type": "string" },
          "label": { "type": "string" },
          "unit": { "type": "string" },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["date", "value"],
              "properties": {
                "date": { "type": "string" },
                "value": { "type": "number" }
              }
            }
          },
          "latest": {
            "type": "object",
            "required": ["date", "value"]
          }
        }
      }
    }
  }
}
